# ---------------------------------------------------------------------------
# OmniResearch configuration. Copy to .env and adjust.
# Nothing here is required to *start* the app; AI providers can be added in
# the UI (Settings → AI Providers). Credentials entered in the UI are stored
# encrypted in the data directory.
# ---------------------------------------------------------------------------

# Where SQLite, uploads, caches, checkpoints and (embedded) Qdrant live.
OMNI_DATA_DIR=./data

# Bearer token for admin endpoints (providers, credentials, routing, reindexing).
# REQUIRED when the API is reachable from anything other than localhost (e.g. Docker).
OMNI_ADMIN_TOKEN=

# Fernet key used to encrypt stored credentials. Empty = auto-generated into
# $OMNI_DATA_DIR/secret.key (back that file up; losing it makes stored keys unreadable).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OMNI_SECRET_KEY=

# Qdrant server URL. Empty = embedded on-disk Qdrant (single process).
OMNI_QDRANT_URL=
OMNI_QDRANT_API_KEY=

# Outbound network controls (JSON lists).
# Hosts that may resolve to private/loopback IPs — needed for local model servers (vLLM, Ollama, TEI, SearXNG).
OMNI_OUTBOUND_ALLOW_PRIVATE_HOSTS=["localhost","127.0.0.1","host.docker.internal","qdrant","ollama","searxng"]
# If non-empty, provider endpoints must be one of these hosts (suffix match), e.g. ["nvidia.com","openrouter.ai"].
OMNI_OUTBOUND_PROVIDER_ALLOWLIST=[]
OMNI_OUTBOUND_BLOCKLIST=[]

# Parser: auto (Docling if installed, else PyMuPDF) | docling | pymupdf
OMNI_PARSER=auto
OMNI_MAX_UPLOAD_MB=100
OMNI_INGESTION_CONCURRENCY=2
OMNI_OCR_CONCURRENCY=1
OMNI_OCR_RENDER_DPI=200

# Agent bounds
OMNI_AGENT_MAX_ITERATIONS=3
OMNI_AGENT_MAX_SUBQUERIES=6
OMNI_AGENT_MAX_EVIDENCE=40

OMNI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
OMNI_LOG_LEVEL=INFO

# Optional declarative provider bootstrap (applied on startup for ids that don't exist yet).
# See providers.example.json. Secrets are referenced by environment variable name.
# OMNI_PROVIDERS_FILE=/config/providers.json
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
# TAVILY_API_KEY=

# Docker build: set to false for a slim image without Docling/PaddleOCR/fastembed.
INSTALL_ML=true
OMNI_PORT=8000
